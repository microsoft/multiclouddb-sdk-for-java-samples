<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress verbose SDK logging -->
    <logger name="com.azure" level="WARN"/>
    <logger name="com.azure.cosmos" level="ERROR"/>
    <!-- RxGatewayStoreModel logs expected 404s as ERROR during schema provisioning probes -->
    <logger name="com.azure.cosmos.implementation.RxGatewayStoreModel" level="OFF"/>
    <logger name="software.amazon" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="reactor" level="WARN"/>

    <!--
      DefaultAzureCredential probes Managed Identity (IMDS) before falling back
      to the Azure CLI / env credentials. On a developer machine there is no
      Managed Identity, so MSAL logs a benign "Identity not found" ERROR/WARN
      on every run. Auth still succeeds via the fallback, so silence the noise.
    -->
    <logger name="com.microsoft.aad.msal4j" level="OFF"/>

    <logger name="com.multiclouddb" level="WARN"/>
    <logger name="com.multiclouddb.provider" level="ERROR"/>
    <logger name="com.multiclouddb.samples" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
