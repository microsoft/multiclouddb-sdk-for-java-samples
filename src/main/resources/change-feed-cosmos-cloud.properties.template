# ---------------------------------------------------------------------------
#  Change Feed Sample — Azure Cosmos DB (LIVE account, master-key auth)
# ---------------------------------------------------------------------------
#
#  Template — copy to `change-feed-cosmos-cloud.properties` (gitignored) and
#  fill in your endpoint + primary master key:
#
#    cp src/main/resources/change-feed-cosmos-cloud.properties.template \
#       src/main/resources/change-feed-cosmos-cloud.properties
#
#  Then run with:
#    java -Dmulticlouddb.config=change-feed-cosmos-cloud.properties \
#         -cp target/multiclouddb-samples-1.0.0-SNAPSHOT-jar-with-dependencies.jar \
#         com.multiclouddb.samples.changefeed.ChangeFeedSample
#
#  REQUIRED: Cosmos account must have Continuous Backup enabled (any tier).
#  When CB is on, the All-Versions-and-Deletes (AVAD) change feed is available
#  automatically on every container — the sample creates a plain container and
#  reads in AVAD mode. Verify with:
#    az cosmosdb show --name <account> -g <rg> --query backupPolicy.type -o tsv
#  Expect: Continuous
#
#  Get connection info:
#    az cosmosdb show     --name <account> -g <rg> --query documentEndpoint -o tsv
#    az cosmosdb keys list --name <account> -g <rg> --query primaryMasterKey -o tsv
# ---------------------------------------------------------------------------

multiclouddb.provider=cosmos

# --- Application Settings ---------------------------------------------------
# Pick names that don't collide with any pre-existing non-AVAD containers —
# Cosmos cannot retrofit AVAD onto an existing container.
multiclouddb.database=multiclouddb-sdk-for-java-changefeed
multiclouddb.collection=change-feed-demo

# --- Azure Cosmos DB (LIVE) -------------------------------------------------
multiclouddb.connection.endpoint=<REPLACE_ME_ENDPOINT>
multiclouddb.connection.key=<REPLACE_ME_PRIMARY_KEY>
multiclouddb.connection.connectionMode=gateway
