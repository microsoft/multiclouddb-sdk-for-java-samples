<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.azure" level="WARN"/>
    <logger name="software.amazon" level="WARN"/>
    <logger name="com.multiclouddb" level="WARN"/>
    <logger name="com.microsoft.multiclouddb.samples" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
